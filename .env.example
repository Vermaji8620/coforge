# Environment Variables Configuration for CodeForge Runner
# Add these variables to your Vercel Project Settings (Settings -> Environment Variables)

# 1. MongoDB Atlas Connection URI
# Example: mongodb://username:password@shard-00-00.mongodb.net:27017,shard-00-01.mongodb.net:27017/coforge_db?ssl=true&replicaSet=atlas-shard-0&authSource=admin&retryWrites=true&w=majority
# IMPORTANT: In MongoDB Atlas -> Network Access, add IP "0.0.0.0/0" (Allow Access from Anywhere) so Vercel serverless functions can connect.
MONGODB_URI=

# 2. Secret key for signing authentication JWT cookies
JWT_SECRET=your_super_secret_jwt_key_here

# 3. Application Metadata
NEXT_PUBLIC_APP_NAME=CodeForge Runner
